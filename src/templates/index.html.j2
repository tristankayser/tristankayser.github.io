{% extends "base.html.j2" %}
{% block body %}
{% set n = t.nav %}
<div id="loader" aria-hidden="true">
  <div class="loader-text">{% for ch in "Tristan" %}<span style="animation-delay:{{ '%.2f'|format(0.05 + loop.index0 * 0.045) }}s">{{ ch }}</span>{% endfor %}</div>
  <div class="loader-bar"></div>
</div>

<!-- ─── NAV ─── -->
<header class="site-nav" id="navbar">
  <a class="nav-logo" href="#hero">{{ logo_mark|safe }}<span>Tristan Kayser</span></a>
  <nav aria-label="{{ t.ui.nav_label }}">
    <ul class="nav-links">
      <li><a href="#about"><span class="lbl">{{ n.about }}</span></a></li>
      <li><a href="#stack"><span class="lbl">{{ n.stack }}</span></a></li>
      <li><a href="#homelab" class="gold-link"><span class="lbl">{{ n.homelab }}</span></a></li>
      <li><a href="#path"><span class="lbl">{{ n.path }}</span></a></li>
      <li><a href="#life"><span class="lbl">{{ n.life }}</span></a></li>
      <li class="nav-cta-li"><a href="#contact"><span class="lbl">{{ n.contact }}</span></a></li>
    </ul>
  </nav>
  {{ lang_switch() }}
  <button class="hamburger" id="hamburger" aria-controls="mobileNav" aria-expanded="false" aria-label="{{ t.ui.menu_open }}" data-open="{{ t.ui.menu_open }}" data-close="{{ t.ui.menu_close }}">
    <span></span><span></span><span></span>
  </button>
</header>

<nav class="mobile-nav" id="mobileNav" aria-label="{{ t.ui.nav_label }}" inert>
  <a href="#about"><span class="lbl">{{ n.about }}</span></a>
  <a href="#stack"><span class="lbl">{{ n.stack }}</span></a>
  <a href="#homelab" class="gold-link"><span class="lbl">{{ n.homelab }}</span></a>
  <a href="#path"><span class="lbl">{{ n.path }}</span></a>
  <a href="#life"><span class="lbl">{{ n.life }}</span></a>
  <a href="#contact"><span class="lbl">{{ n.contact }}</span></a>
  <a href="lebenslauf.html"><span class="lbl">{{ n.cv }}</span></a>
  {{ lang_switch() }}
</nav>

<main id="main">
<!-- ─── HERO ─── -->
<section id="hero" aria-labelledby="hero-title">
  <div class="hero-bg" id="heroBg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="hero-badge"><span class="badge-dot" aria-hidden="true"></span>{{ t.hero.badge }}</p>
    <h1 class="hero-name" id="hero-title">
      <span class="name-wrap"><span class="name-line">Tristan</span></span>
      <span class="name-wrap"><span class="name-line name-outline">Kayser</span></span>
    </h1>
    <p class="hero-sub">{{ t.hero.sub }}</p>
    <p class="hero-line">{{ t.hero.line }}</p>
    <div class="hero-ctas">
      <a href="#stack" class="btn btn-primary magnetic">{{ t.hero.cta_primary }}</a>
      <a href="#contact" class="btn btn-ghost magnetic">{{ t.hero.cta_secondary }}</a>
    </div>
  </div>

  <dl class="hero-stats">
    {% for s in t.hero.stats %}
    <div><dt class="hs-label">{{ s.label }}</dt><dd class="hs-num"><span class="count" data-target="{{ s.num }}">{{ s.num }}</span>{% if s.sup %}<sup>{{ s.sup }}</sup>{% endif %}</dd></div>
    {% endfor %}
  </dl>
  <div class="scroll-hint" aria-hidden="true"><span>{{ t.ui.scroll }}</span><div class="scroll-line"></div></div>
</section>

<!-- ─── #01 ABOUT ─── -->
<section id="about" class="section" aria-labelledby="about-h">
  <div class="section-wrap about-grid">
    <figure class="about-photo">
      <div class="about-photo-img reveal-img">
        <img src="assets/img/portrait-800.webp" srcset="assets/img/portrait-480.webp 480w, assets/img/portrait-800.webp 800w"
             sizes="(max-width:900px) 80vw, 34vw" width="800" height="998" alt="{{ t.about.photo_alt }}" loading="lazy" decoding="async"/>
      </div>
      <div class="photo-border" aria-hidden="true"></div>
    </figure>
    <div class="about-text">
      <p class="sec-header"><span class="no">#01</span> {{ t.about.label }}</p>
      <h2 class="about-h gs-reveal" id="about-h">{{ t.about.headline|safe }}</h2>
      {% for p in t.about.paras %}<p class="about-p gs-reveal">{{ p }}</p>
      {% endfor %}
      <dl class="facts gs-reveal">
        {% for f in t.about.facts %}<div><dt>{{ f.k }}</dt><dd>{{ f.v }}</dd></div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>

<!-- ─── #02 STACK (animated app tiles) ─── -->
{% set tl = t.stack.tiles %}
<section id="stack" class="section" aria-labelledby="stack-h">
  <div class="section-wrap">
    <div class="sec-top">
      <h2 class="sec-header" id="stack-h"><span class="no">#02</span> {{ t.stack.label }}</h2>
      <p class="sec-intro">{{ t.stack.intro }}</p>
    </div>

    <div class="bento">
      <!-- Terminal -->
      <article class="tile tile-term" data-tile="term">
        <div class="tile-vis win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>tristan@pve-compute: ~</span></div>
          <pre class="term" id="termOut"><span class="p">$ </span><span class="c">qm list</span>
  VMID NAME          STATUS
  101  llm-vm        <span class="ok">running</span>
  102  librechat     <span class="ok">running</span>
  110  docker-apps   <span class="ok">running</span>
<span class="p">$ </span><span class="c">ansible-playbook win11-updates.yml</span>
PLAY RECAP  <span class="ok">ok=14</span>  changed=4  failed=0</pre>
        </div>
        <div class="tile-txt"><h3>{{ tl.terminal.title }}</h3><p>{{ tl.terminal.text }}</p></div>
      </article>

      <!-- Proxmox -->
      <article class="tile tile-pve" data-tile="pve">
        <div class="tile-vis win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>Datacenter</span></div>
          <ul class="pve">
            {% for nd, c, r in [('pve-edge', 18, 42), ('pve-compute', 64, 71), ('pve-apps', 27, 55)] %}
            <li data-node="{{ nd }}"><span class="pve-n"><b></b>{{ nd }}</span>
              <span class="bar" title="CPU"><i style="width:{{ c }}%"></i></span>
              <span class="bar ram" title="RAM"><i style="width:{{ r }}%"></i></span></li>
            {% endfor %}
          </ul>
          <p class="pve-foot"><span class="pve-ev" id="pveEv"><span>PBS</span> backup vm/101 ok · 02:00</span><i class="pve-prog" id="pveProg"></i></p>
        </div>
        <div class="tile-txt"><h3>{{ tl.proxmox.title }}</h3><p>{{ tl.proxmox.text }}</p></div>
      </article>

      <!-- Firewall -->
      <article class="tile tile-fw" data-tile="fw">
        <div class="tile-vis win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>OPNsense · live log</span><em class="fw-count" id="fwCount"><b class="ok">✓ 1 284</b> <b class="no">✕ 37</b></em></div>
          <ol class="fw" id="fwLog" data-allow="{{ t.stack.fw_allow }}" data-block="{{ t.stack.fw_block }}">
            {% for ok, rt, pt in [(1,'LAN → WAN','443/tcp'),(0,'IoT → LAN','22/tcp'),(1,'VPN → MGMT','8006/tcp'),(1,'LAN → DNS','53/udp'),(0,'WAN → LAN','3389/tcp'),(1,'LAN → NAS','445/tcp')] %}<li><span class="act {{ 'allow' if ok else 'block' }}">{{ t.stack.fw_allow if ok else t.stack.fw_block }}</span><span class="rt">{{ rt }}</span><span class="pt">{{ pt }}</span></li>{% endfor %}
          </ol>
        </div>
        <div class="tile-txt"><h3>{{ tl.firewall.title }}</h3><p>{{ tl.firewall.text }}</p></div>
      </article>

      <!-- Active Directory -->
      <article class="tile tile-ad" data-tile="ad">
        <div class="tile-vis win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>Active Directory</span></div>
<pre class="adtree" id="adTree"><span data-k="root">▾ corp.local</span><span data-k="ou-it">  ├─ ▾ OU IT</span><span data-k="user">  │   ├─ ▪ t.kayser</span><span data-k="gpo-drive">  │   └─ ◆ GPO  drive-mapping</span><span data-k="ou-cl">  ├─ ▾ OU Clients</span><span data-k="clients">  │   └─ ▪ <b id="adCount">24</b> × Windows 11</span><span data-k="gpo-wu">  └─ ◆ GPO  windows-update</span></pre>
          <p class="ad-ev" id="adEv" aria-hidden="true"></p>
        </div>
        <div class="tile-txt"><h3>{{ tl.ad.title }}</h3><p>{{ tl.ad.text }}</p></div>
      </article>

      <!-- Local AI -->
      <article class="tile tile-ai" data-tile="ai">
        <div class="tile-vis win" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>LibreChat · local</span></div>
          <div class="chat">
            <p class="msg me" id="aiQ">{{ t.stack.ai_pairs[0].q }}</p>
            <p class="msg bot" id="aiOut" data-pairs='{{ t.stack.ai_pairs|tojson }}'>{{ t.stack.ai_pairs[0].a }}</p>
            <p class="chat-foot" id="aiFoot">llama.cpp · glm-4.7-flash · 8.1 tok/s</p>
          </div>
        </div>
        <div class="tile-txt"><h3>{{ tl.ai.title }}</h3><p>{{ tl.ai.text }}</p></div>
      </article>

      <!-- Logo marquee -->
      <div class="tile tile-marquee" aria-label="{{ t.stack.marquee_label }}" role="group">
        {% for row in [logos[:13], logos[13:]] %}
        <div class="marquee{% if loop.index == 2 %} rev{% endif %}">
          <ul class="marquee-track">
            {% for _ in range(2) %}{% set outer = loop.index %}{% for lg in row %}
            <li{% if outer == 2 %} aria-hidden="true"{% endif %}>{{ lg.svg|safe }}<span>{{ lg.name }}</span></li>
            {% endfor %}{% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- ─── #03 HOMELAB ─── -->
<section id="homelab" class="section" aria-labelledby="hl-h">
  <div class="section-wrap hl-grid">
    <div class="hl-side">
      <h2 class="sec-header gold-hd" id="hl-h"><span class="no">#03</span> {{ t.homelab.label }}</h2>
      <p class="sec-intro">{{ t.homelab.intro }}</p>
      <dl class="hl-stats">
        {% for s in t.homelab.stats %}<div class="hl-stat"><dt>{{ s.label }}</dt><dd>{{ s.num }}</dd></div>
        {% endfor %}
      </dl>
      <ul class="hl-nodes">
        {% for nd in t.homelab.nodes %}<li class="tone-{{ nd.tone }}"><b>{{ nd.name }}</b><span>{{ nd.role }}</span></li>
        {% endfor %}
      </ul>
    </div>
    <figure class="hl-flow">
      <div class="hl-flow-svg" tabindex="0" role="region" aria-label="{{ t.homelab.flow_label }}">{{ flow_svg|safe }}</div>
    </figure>
  </div>
</section>

<!-- ─── #04 PATH ─── -->
<section id="path" class="section" aria-labelledby="path-h">
  <div class="section-wrap">
    <h2 class="sec-header" id="path-h"><span class="no">#04</span> {{ t.path.label }}</h2>
    <div class="path-scroll" tabindex="0" role="region" aria-label="{{ t.path.label }}">
      <span class="path-line" aria-hidden="true"><i></i></span>
      <ol class="path">
        {% for e in t.path['items'] %}
        <li class="path-item{% if e.current %} current{% endif %}">
          <span class="path-dot" aria-hidden="true"></span>
          <p class="path-date">{{ e.date }}</p>
          <h3 class="path-title">{{ e.title }}</h3>
          <p class="path-org">{{ e.org }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

<!-- ─── #05 LIFE ─── -->
<section id="life" class="section" aria-labelledby="life-h">
  <div class="section-wrap">
    <div class="sec-top">
      <h2 class="sec-header" id="life-h"><span class="no">#05</span> {{ t.life.label }}</h2>
      <p class="sec-intro">{{ t.life.intro }}</p>
    </div>
    <div class="gallery">
      {% for ph in t.life.photos %}
      <figure class="g-item">
        <div class="g-img reveal-img">
          {% if ph.img == 'drone' %}<img src="assets/img/drone-800.webp" width="800" height="512" alt="{{ ph.alt }}" loading="lazy" decoding="async"/>
          {% else %}<img src="assets/img/{{ ph.img }}-900.webp" srcset="assets/img/{{ ph.img }}-480.webp 480w, assets/img/{{ ph.img }}-900.webp 900w" sizes="(max-width:767px) 90vw, 33vw" alt="{{ ph.alt }}" loading="lazy" decoding="async"/>{% endif %}
        </div>
        <figcaption><b>{{ ph.cap }}</b><span>{{ ph.sub }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
    <ul class="interests">{% for i in t.life.interests %}<li>{{ i }}</li>{% endfor %}</ul>
  </div>
</section>

<!-- ─── #06 CONTACT ─── -->
<section id="contact" class="section" aria-labelledby="ct-h">
  <div class="contact-bg-img" id="contactBg" aria-hidden="true"></div>
  <div class="contact-overlay" aria-hidden="true"></div>
  <div class="contact-inner">
    <p class="sec-header gold-hd"><span class="no">#06</span> {{ t.contact.label }}</p>
    <h2 class="contact-hl gs-reveal" id="ct-h">{{ t.contact.headline|safe }}</h2>
    <p class="contact-sub gs-reveal">{{ t.contact.sub }}</p>
    <ul class="contact-row gs-reveal">
      <li class="ct-item">
        <a href="mailto:tristankayser1@gmail.com" class="ct-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg>
          <span><small>{{ t.contact.email }}</small>tristankayser1@gmail.com</span>
        </a>
        <button type="button" class="ct-copy" data-copy="tristankayser1@gmail.com" data-done="{{ t.ui['copied'] }}" aria-label="{{ t.ui['copy'] }}: tristankayser1@gmail.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1"/><path d="M16 8V4H4v12h4"/></svg>
        </button>
        <span class="sr-only" aria-live="polite" id="copyStatus"></span>
      </li>
      <li class="ct-item">
        <a href="tel:{{ phone|replace(' ', '') }}" class="ct-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 006 6L16 13l5 2v4a2 2 0 01-2 2A16 16 0 013 5a2 2 0 012-2z"/></svg>
          <span><small>{{ t.contact.phone }}</small>{{ phone }}</span>
        </a>
      </li>
      <li class="ct-item">
        <a href="https://github.com/Intersepter" class="ct-link" rel="me noopener">
          {{ github_svg|safe }}
          <span><small>{{ t.contact.github }}</small>Intersepter</span>
        </a>
      </li>
      <li class="ct-item">
        <a href="lebenslauf.html" class="ct-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6v18h12V7z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg>
          <span><small>{{ t.contact.cv }}</small>{{ n.cv }}</span>
        </a>
      </li>
    </ul>
  </div>
</section>
</main>

<button class="scroll-top" id="scrollTop" aria-label="{{ t.ui.to_top }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg></button>

{% include "footer.html.j2" %}

<script src="assets/js/vendor/gsap.min.js?v={{ version }}" defer></script>
<script src="assets/js/vendor/ScrollTrigger.min.js?v={{ version }}" defer></script>
<script src="assets/js/vendor/lenis.min.js?v={{ version }}" defer></script>
<script src="assets/js/main.js?v={{ version }}" defer></script>
{% endblock %}
